title: Debug_Route
---
<<if $debugTarget == "s1">>
    <<jump Session1>>
<<elseif $debugTarget == "s2">>
    <<jump Session2>>
<<elseif $debugTarget == "s3">>
    <<jump Session3>>
<<elseif $debugTarget == "s4">>
    <<jump Session4_Start>>
<<elseif $debugTarget == "s5">>
    <<jump Session5_Start>>
<<elseif $debugTarget == "s6_dhorn">>
    <<set $session5Route = "dhorn">>
    <<set $sharedVatraPlansWithDhorn = true>>
    <<set $dhornTrust = 65>>
    <<set $governmentTrust = 45>>
    <<set $escalation = 2>>
    <<jump Session6_Start>>
<<elseif $debugTarget == "s6_government">>
    <<set $session5Route = "government">>
    <<set $sharedDhornRoutesWithGovernment = true>>
    <<set $dhornTrust = 45>>
    <<set $governmentTrust = 65>>
    <<set $escalation = 2>>
    <<jump Session6_Start>>
<<elseif $debugTarget == "s6_independent">>
    <<set $session5Route = "independent">>
    <<set $refusedBothSidesS5 = true>>
    <<set $dhornTrust = 50>>
    <<set $governmentTrust = 50>>
    <<set $escalation = 1>>
    <<jump Session6_Start>>
<<elseif $debugTarget == "s7_standard">>
    <<set $foundV27ArchiveTrace = true>>
    <<set $recognizedV27Symbol = true>>
    <<set $rememberedSymbolAtHome = true>>
    <<set $foundIncidentReport = true>>
    <<set $knowsSurfaceExtraction = true>>
    <<set $knowsVornSilenced = true>>
    <<set $dhornTrust = 55>>
    <<set $governmentTrust = 55>>
    <<set $escalation = 2>>
    <<jump Session7_Start>>
<<elseif $debugTarget == "s7_truth">>
    <<set $foundV27ArchiveTrace = true>>
    <<set $recognizedV27Symbol = true>>
    <<set $rememberedSymbolAtHome = true>>
    <<set $foundIncidentReport = true>>
    <<set $knowsVatra7Correlation = true>>
    <<set $knowsSurfaceExtraction = true>>
    <<set $knowsVornSilenced = true>>
    <<set $dhornTrust = 60>>
    <<set $governmentTrust = 60>>
    <<set $escalation = 1>>
    <<jump Session7_Start>>
<<elseif $debugTarget == "s8_dhorn">>
    <<set $finalChoice = "dhorn">>
    <<set $truthReady = false>>
    <<set $escalation = 2>>
    <<set $dhornTrust = 65>>
    <<set $governmentTrust = 45>>
    <<set $grandfatherIsV27 = true>>
    <<jump Session8_Start>>
<<elseif $debugTarget == "s8_government">>
    <<set $finalChoice = "government">>
    <<set $truthReady = false>>
    <<set $escalation = 2>>
    <<set $dhornTrust = 45>>
    <<set $governmentTrust = 65>>
    <<set $grandfatherIsV27 = true>>
    <<jump Session8_Start>>
<<elseif $debugTarget == "s8_truth">>
    <<set $finalChoice = "truth">>
    <<set $truthReady = true>>
    <<set $escalation = 1>>
    <<set $dhornTrust = 65>>
    <<set $governmentTrust = 65>>
    <<set $grandfatherIsV27 = true>>
    <<set $foundV27ArchiveTrace = true>>
    <<set $foundIncidentReport = true>>
    <<set $knowsVornSilenced = true>>
    <<set $v27SavedOriginals = true>>
    <<set $knowsVatra7Correlation = true>>
    <<jump Session8_Start>>
<<elseif $debugTarget == "s8_war">>
    <<set $finalChoice = "truth">>
    <<set $truthReady = true>>
    <<set $escalation = 7>>
    <<set $framedDhornAsAttackers = true>>
    <<jump Session8_Start>>
<<else>>
    Kael: Nepoznat debug preset.
<<endif>>
===
